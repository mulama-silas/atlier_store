# NOTE: Gemini is called ONLY by the Django backend (backend/.env sets
# GEMINI_API_KEY). No VITE_GEMINI_* variable may ever exist here.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase persistence and authentication
# The service-role key must NOT be exposed to the browser.
# Only VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are safe for frontend use.
SUPABASE_URL="https://ngpzjddvkgopfmghjqnv.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY has been removed from frontend configuration.
# It must only exist on the server (backend/.env, not committed to source).
VITE_SUPABASE_URL="https://ngpzjddvkgopfmghjqnv.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_ZwpA6R_KQj9FTFuYYEGJlA_dViTJDb9"

# --- Analytics replica (backend only -- NOT VITE_*, never in the browser) ---
# SUPABASE_DB_URL is the DIRECT Postgres URI from Supabase -> Project Settings
# -> Database. Not the PostgREST URL: the replica lives in its own schema so the
# anon key above cannot read it, and PostgREST only serves `db-schemas` entries.
# SUPABASE_DB_URL="postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres"
# Destination for the image mirror. Create it once as a PRIVATE bucket.
# REPLICA_BACKUP_BUCKET="product-images-backup"
# Guards POST /api/admin/replica/sync for the external cron. While unset the
# endpoint answers 404 rather than existing unauthenticated.
# REPLICA_SYNC_TOKEN="replace-with-a-long-random-secret"
# inline   = the admin button runs the sync inside the request.
# deferred = the admin button queues a run for background processing.
# REPLICA_SYNC_MODE="deferred"
# Built-in Python loop in the backend container; no Celery or external cron.
# REPLICA_AUTO_SYNC_ENABLED="true"
# REPLICA_AUTO_SYNC_INTERVAL_SECONDS="10"

# --- Admin recovery (backend only) -----------------------------------------
# Read by `ensure_superuser`, which the Dockerfile runs on every container
# start. On the free plan there is no Render Shell, so this is the ONLY way
# back into the admin if the superuser is ever lost.
# DJANGO_SUPERUSER_USERNAME="admin"
# DJANGO_SUPERUSER_EMAIL="admin@example.com"
# DJANGO_SUPERUSER_PASSWORD="replace-with-a-long-random-secret"

# --- Demo-data reset (backend only) ---------------------------------------
# Gates /admin/dashboard/reset-data/ and `manage.py reset_demo_data`. While
# this is false the page answers 404 and the command refuses to run, so
# handover to a client is a config change and not a code deletion.
# ENABLE_DATA_RESET="false"
VITE_API_BASE_URL="http://127.0.0.1:8000"
VITE_ADMIN_URL="http://127.0.0.1:8000/admin/dashboard/"
VITE_DEFAULT_WHATSAPP_NUMBER="+254768873844"

# Application security (server-only variables belong in backend/.env)
SESSION_SECRET="replace-with-a-long-random-secret"

# ADMIN_API_TOKEN: Optional dev-only bearer token for Express server admin auth.
# Ignored in production (NODE_ENV=production); admin auth uses Supabase JWT there.
ADMIN_API_TOKEN=""

# Customer support contact shown on the storefront
VITE_SUPPORT_EMAIL=
